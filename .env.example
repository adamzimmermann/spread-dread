APP_ENV=dev
APP_SECRET=changeme_generate_a_real_secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
DATABASE_URL="mysql://db:db@db:3306/db?serverVersion=8.0&charset=utf8mb4"
ODDS_API_KEY="your_odds_api_key_here"

###> symfony/mailer ###
# Invitation and password-reset emails are sent through this. Set a real DSN
# in .env.local (never committed) — on the server, for a third-party SMTP
# provider; locally, only if you want to actually receive the emails you
# trigger. Left as null://null, mail is silently discarded, which is fine for
# most local development.
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
###< symfony/mailer ###
