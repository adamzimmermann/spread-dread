<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token('app') }}">
    <title>{% block title %}Spread Dread{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>
<body class="bg-gray-100 min-h-screen">
    <nav class="bg-blue-800 text-white px-4 py-3 flex items-center justify-between">
        <a href="{{ path('app_home') }}" class="text-lg font-bold">Spread Dread</a>
        {% if app.session.get('user_id') %}
            <span class="text-sm text-blue-200 mr-3">{{ app.session.get('username') }}</span>
            {% if app_auth.user and app_auth.user.admin %}
                <a href="{{ path('app_admin_dashboard') }}" class="text-sm text-blue-200 hover:text-white mr-3">Admin</a>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="text-sm text-blue-200 hover:text-white">Logout</a>
        {% endif %}
    </nav>

    {% for type in ['success', 'error', 'warning', 'info'] %}
        {% for message in app.flashes(type) %}
            <div class="px-4 py-2 text-sm {{ type == 'error' ? 'bg-red-100 text-red-800' : (type == 'success' ? 'bg-green-100 text-green-800' : (type == 'warning' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800')) }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main class="{% block main_class %}max-w-2xl mx-auto px-4 py-4{% endblock %}">
        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</body>
</html>
