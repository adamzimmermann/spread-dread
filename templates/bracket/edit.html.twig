{% extends 'base.html.twig' %}

{% block title %}Edit {{ bracket.name }}{% endblock %}

{% block body %}
<h1 class="text-xl font-bold text-gray-800 mb-4">Edit Bracket</h1>

<form method="post" class="space-y-4">
    <input type="hidden" name="_token" value="{{ csrf_token('app') }}">
    <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Bracket Name</label>
        <input type="text" name="name" id="name" value="{{ bracket.name }}" required
               class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
    </div>

    <div>
        <span class="block text-sm font-medium text-gray-700 mb-1">Player 1</span>
        <p class="border border-gray-200 bg-gray-50 rounded px-3 py-2 text-gray-700">{{ bracket.player1Name }}</p>
    </div>

    <div>
        <label for="opponent_username" class="block text-sm font-medium text-gray-700 mb-1">Who are you playing?</label>
        <input type="text" name="opponent_username" id="opponent_username" list="opponents"
               autocomplete="off" placeholder="Start typing a username"
               value="{{ bracket.player2 ? bracket.player2.username : '' }}"
               class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <datalist id="opponents">
            {% for u in opponents %}<option value="{{ u.username }}">{% endfor %}
        </datalist>
        {% if opponents is empty %}
            <p class="text-sm text-gray-500 mt-1">No other active players yet — ask an admin to invite someone.</p>
        {% endif %}
    </div>

    <button type="submit"
            class="w-full bg-blue-700 text-white py-2 rounded font-medium hover:bg-blue-800">
        Save Changes
    </button>
</form>

<a href="{{ path('app_bracket_show', {id: bracket.id}) }}" class="block text-center text-sm text-blue-600 mt-4 hover:underline">Cancel</a>
{% endblock %}
