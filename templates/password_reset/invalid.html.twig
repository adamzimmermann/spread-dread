{% extends 'base.html.twig' %}

{% block title %}Password reset - Spread Dread{% endblock %}

{% block body %}
<div class="mt-16 flex flex-col items-center text-center">
    <h1 class="text-2xl font-bold text-gray-800 mb-4">This password reset link is no longer valid</h1>
    <p class="text-gray-600 max-w-sm">It may have expired or already been used. You can request a new one.</p>
    <a href="{{ path('app_password_forgot') }}" class="text-sm text-blue-600 mt-6 hover:underline">Request a new link</a>
</div>
{% endblock %}
